ENVIRONMENT=production
DATABASE_URL=postgresql+psycopg://<database-user>:<database-password>@<persistent-postgresql-host>:5432/<database-name>?sslmode=verify-full
SESSION_HMAC_SECRET=<independent-random-secret-at-least-32-characters>
# JWT_SECRET=<not applicable: this API issues opaque server sessions, not JWTs>
DEVICE_BINDING_SECRET=<different-independent-random-secret-at-least-32-characters>
PAYMENT_ENCRYPTION_KEY=<Fernet-key-generated-outside-source-control>
PUBLIC_BASE_URL=https://<real-production-api-domain>/
ALLOWED_HOSTS=<real-production-api-domain>
CORS_ORIGINS=https://<approved-browser-origin>
ADMIN_EMAILS=<approved-administrator-email-addresses>
FORWARDED_ALLOW_IPS=<trusted-ingress-proxy-ip-or-cidr>
DB_CONNECT_TIMEOUT_SECONDS=5
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800
WEB_CONCURRENCY=2
GRACEFUL_SHUTDOWN_SECONDS=30
ADMOB_SSV_VERIFIED=false
ADMOB_APP_ID=ca-app-pub-4973946737213196~3854510671
ADMOB_REWARDED_UNIT_ID=2667340525
ADMOB_SSV_KEY_URL=https://www.gstatic.com/admob/reward/verifier-keys.json
WALLET_FUNDING_ENABLED=false
REWARD_POLICY_ID=
WITHDRAWALS_ENABLED=false
PLAY_INTEGRITY_CLOUD_PROJECT_NUMBER=0
PLAY_INTEGRITY_PACKAGE_NAME=com.adsearn.mobile
# Supply the real project number and certificate digest before explicitly enabling sessions.
PLAY_INTEGRITY_CERTIFICATE_SHA256=
ANONYMOUS_SESSIONS_ENABLED=false
EDGE_RATE_LIMITING_CONFIGURED=false
SESSION_TTL_DAYS=30
WITHDRAWAL_MINIMUM=0.00
# Use the host's workload identity or a secret-mounted ADC credential file.
# Never commit service-account JSON, private keys, or database credentials.
